rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Papers Collection (Public Metadata & Exam Paper Retrieval)
    match /papers/{paperId} {
      allow read: if true;
      allow write: if false;
    }

    // DENY ALL DIRECT CLIENT ACCESS TO ANSWER KEYS (Server Scored Only)
    match /answerKeys/{qvid} {
      allow read, write: if false;
    }

    // Question Versions (Learner facing - Read Only)
    match /questionVersions/{qvid} {
      allow read: if true;
      allow write: if false;
    }

    // Test Versions (Public Catalog Metadata - Read Only)
    match /testVersions/{testId} {
      allow read: if true;
      allow write: if false;
    }

    // Learner Profiles: User can read their profile, but cannot self-elevate role or activePasses
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['role', 'activePasses']) || request.resource.data.role == 'LEARNER');
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'activePasses']);
      allow delete: if false;
    }

    // Attempts: Read own attempts; direct client update/delete is forbidden to preserve immutable audit trail
    match /attempts/{attemptId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Orders & Grants: Server-only writes
    match /orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /grants/{grantId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
